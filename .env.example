# SiliconFlow 注册: https://cloud.siliconflow.cn （新用户有免费额度）
# 创建 API Key: 控制台 -> API密钥 -> 创建。一个 key 通吃 LLM / Embedding / Rerank。
SILICONFLOW_API_KEY=sk-xxxxxxxxxxxxxxxx

# 模型（SiliconFlow 模型名；免费额度可换 Qwen/Qwen2.5-7B-Instruct 等）
BASE_URL=https://api.siliconflow.cn/v1
LLM_MODEL=deepseek-ai/DeepSeek-V3
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# 备用供应商槽位（预留结构，切换/熔断逻辑在后续加固版实现；留空 = 不启用）
# BACKUP_BASE_URL=
# BACKUP_API_KEY=
# BACKUP_LLM_MODEL=

# 服务端口（服务器上若被占用，改这里 + 重启）
PORT=8200

# ---- 鉴权 ----
# AUTH_ENABLED=true  正常跑法：先 /auth/login 换 token，业务接口带 Authorization: Bearer <token>
# AUTH_ENABLED=false 本地免登录演示跑法：不校验 token，默认以管理员身份直连（便于只体验 RAG/Agent）
AUTH_ENABLED=true
# JWT 签名密钥：生产务必换成强随机串（>=32 字符），换掉后旧 token 全部失效
SECRET_KEY=dev-only-change-me-please-override-4b96f1
# token 有效期（分钟），默认 24 小时
# TOKEN_EXPIRE_MINUTES=1440
# 覆盖内置演示账号，格式为 JSON 数组（role: user 普通用户 / admin 管理员）
# DEMO_USERS_JSON=[{"username":"tom","password":"p123456","role":"user"}]
# 内置演示账号：alice/alice123(user) bob/bob123(user) admin/admin123(admin)

# ---- 关系库：元数据 + 会话记录 ----
# 默认 SQLite 零依赖一键跑（README 的"零依赖档"）。
# 生产/多副本档换 Postgres，只换连接串，代码不变：
#   DB_URL=postgresql+psycopg://rag:rag@127.0.0.1:5433/rag
# 为什么不给 MySQL：会话记忆用 LangGraph 官方 checkpointer，官方只出 sqlite/postgres，
# 没有 MySQL saver（详见 README「分布式组件怎么起作用」）。
DB_URL=sqlite:///data/app.db

# ---- 会话记忆 checkpointer（与上面 DB_URL 是两回事：那是应用表，这是 LangGraph 的记忆表）----
# sqlite   = 本地零依赖档（记忆落 sqlite 文件）
# postgres = 生产/多副本档（记忆落 Postgres，换副本不失忆）
# CHECKPOINT_BACKEND=sqlite
# POSTGRES_DSN=postgresql://rag:rag@127.0.0.1:5433/rag

# ---- Redis：跨进程限流 + 检索缓存（留空 = 不启用，退回进程内单机实现）----
# REDIS_URL=redis://127.0.0.1:6380/0
# 每客户端每分钟请求上限；0 = 关闭限流（默认关，演示不误伤）
# RATE_LIMIT_PER_MIN=60
# CACHE_ENABLED=true
# 三层检索缓存 TTL（秒）：改写结果 / 文本向量 / 检索结果
# CACHE_TTL_REWRITE=3600
# CACHE_TTL_EMBEDDING=86400
# CACHE_TTL_RETRIEVAL=300

# ---- 向量库部署形态 ----
# 空 = 嵌入式文件库 data/chroma（零依赖档）；填 host 则连独立 Chroma server（多副本档）。
# CHROMA_HOST=127.0.0.1
# CHROMA_PORT=8001

# ---- 部署在自有反向代理（nginx 等）后面时置 true ----
# 限流按 X-Forwarded-For 首跳分桶。不置 true 则按 TCP 对端 IP —— 反代后面那永远是
# 反代的 IP，所有客户端会挤进同一个限流桶。不要无条件信任该头：客户端能自己伪造。
# TRUST_PROXY=false

# ---- 外部 MCP 工具（留空 = 不接外部工具）----
# 把外部 MCP server 的工具挂进 ReAct agent。command 写 "python" 会自动换成当前解释器，
# cwd 默认项目根。本项目自带一个示例 server（模拟仓储 WMS）可直接用：
# MCP_SERVERS_JSON={"wms":{"command":"python","args":["-m","mcp_servers.wms_server"],"transport":"stdio"}}

# 上传限制（MB）
# MAX_UPLOAD_MB=20

# ---- MinerU Cloud OCR（扫描/图像 PDF 自动识别，可选）----
# 注册: https://mineru.net（每日 1000 页高优先级额度）。配置后，上传的 PDF 若探到
# 无文字层（扫描/图像件），自动走 MinerU v4 上传-轮询-下载 zip 提取 Markdown。
# 不配时扫描件上传会解析失败并提示"需配置 MINERU_API_KEY"；文字层 PDF 不受影响。
# MINERU_API_KEY=sk-xxxxxxxxxxxxxxxx

# 浏览器跨域白名单（逗号分隔）；默认空=不开 CORS。纯服务端/内网直连不用配
# CORS_ORIGINS=http://localhost:5173,https://your-frontend.example.com

# Agent ReAct 单轮最大步数（防跑飞护栏；LangGraph 默认就是 25）
# AGENT_RECURSION_LIMIT=25

# ---- 追加型 JSONL（trace / eval 报告）轮转，防磁盘无界增长 ----
# 文件超过 JSONL_ROTATE_BYTES 才做行数截尾（避免每次追加都读全文件），
# 保留最近 JSONL_KEEP_ENTRIES 条。不满足场景可调大或设 0 关轮转。
# JSONL_ROTATE_BYTES=5000000
# JSONL_KEEP_ENTRIES=2000

# 长会话压缩：线程消息超过 COMPRESS_MIN_MESSAGES 时，下一轮前把更早历史折成一条摘要，
# 只留最近 COMPRESS_KEEP_RECENT 条原文（含当前待答问题）。小样本演示可调低门槛观察
# COMPRESS_MIN_MESSAGES=16
# COMPRESS_KEEP_RECENT=8
